# ─────────────────────────────────────────────────────────────────────────────
# مِداد | MIDAD — production environment template
# Copy to the host's environment settings (or to .env on a server). Never commit real values.
# Lines marked [YOU] must be filled by you; the rest can stay as they are.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="مِداد | MIDAD"
APP_ENV=production
APP_DEBUG=false
# [YOU] Generate on the server: php artisan key:generate --show   (paste the base64:... value here)
APP_KEY=
# [YOU] Your final address, with https://
APP_URL=https://midad.example.com
FORCE_HTTPS=true

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ── Database ── [YOU] values from your host's database panel (MySQL shown; for PostgreSQL use DB_CONNECTION=pgsql, port 5432)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sessions: stored in the database, encrypted, cookie sent over HTTPS only ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Email (password reset) — Gmail SMTP ── [YOU] Gmail address + Google App Password
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Leave empty to send as MAIL_USERNAME (Gmail requires that)
MAIL_FROM_ADDRESS=
# Hosts that block SMTP (Render's free plan): MAIL_MAILER=brevo and the key from Brevo → SMTP & API → API Keys.
BREVO_API_KEY=
MAIL_FROM_NAME="مِداد | MIDAD"

# Optional site features (leave empty to disable)
ETHRAA_SPECIAL_PROFILE_EMAIL=
ETHRAA_SIGNUP_NOTIFICATION_EMAILS=

VITE_APP_NAME="${APP_NAME}"
